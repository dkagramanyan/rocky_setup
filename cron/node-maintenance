# /etc/cron.d/node-maintenance
# The script applies its own MAINT_JITTER_SEC, so every node can share this file.
# cron reads % as a newline, escape it as \% if you add date formats here.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
MAILTO=""

20 3 * * *   root  /usr/local/sbin/node-maintenance.sh --clean-only
15 4 * * 0   root  /usr/local/sbin/node-maintenance.sh
